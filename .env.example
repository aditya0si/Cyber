# Local-only secrets example. Never commit a real .env.
# Backend
ENV=local
LOG_LEVEL=INFO

# Postgres
DATABASE_URL=postgresql+asyncpg://cybersim:cybersim_dev@localhost:5432/cybersim

# Redis
REDIS_URL=redis://localhost:6379/0

# Object store (MinIO dev)
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=cybersim
OBJECT_STORE_SECRET_KEY=cybersim_dev
OBJECT_STORE_BUCKET=cybersim

# LLM (leave blank to run on rule-fallback tier)
LLM_PROVIDER=openai
LLM_MODEL_TRIAGE=gpt-4o-mini
LLM_MODEL_ANALYSIS=gpt-4o
OPENAI_API_KEY=

# Knowledge embeddings
KNOWLEDGE_EMBED_MODEL=text-embedding-3-small

# Auth (generate with: python -c "from cryptography.hazmat.primitives.asymmetric import rsa; print(rsa.generate_private_key(65537,2048).private_bytes(...).decode())")
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=dev-1
JWT_ISSUER=http://localhost:8000
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# Stripe (test mode by default)
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=sim_price_pro

# Observability
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Graph backend
GRAPH_BACKEND=nx
